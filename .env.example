# Server Configuration
PORT=8000
HOST=localhost
LOGGER=1

# Database Configuration (PostgreSQL)
URL_DB_POSTGRES=postgresql://postgres:password@localhost:5432/picsee

# Security & Authentication
JWT_KEY_SECRET=your_jwt_secret_key
JWT_SECRET_RECOVER_PASS=your_jwt_recovery_secret
SECRET_ENCRYPT=your_aes_encryption_secret

# Default Assets
DEFAULT_AVATAR_URL=https://ik.imagekit.io/picsee/default-avatar.png

# ImageKit Configuration
PUBLIC_KEY_IMAGEKIT=your_imagekit_public_key
PRIVATE_KEY_IMAGEKIT=your_imagekit_private_key
URL_ENDPOINT_IMAGEKIT=https://ik.imagekit.io/picsee/
IMAGES_FOLDER_DEST=posts
AVATARS_FOLDER_DEST=avatars
QUALITY_IMAGES=80

# Google Cloud Storage
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=google-auth.json
BUCKET_NAME=picsee-storage

# Google OAuth2
ID_CLIENT_GOOGLE=your_google_client_id.apps.googleusercontent.com
ID_CLIENT=your_google_client_id.apps.googleusercontent.com

# Email Service (SMTP)
APP_EMAIL=noreply@picsee.app
APP_PASSWORD_EMAIL=your_smtp_app_password
URL_REDIRECT_RECOVER_PASS=https://picsee.app/reset-password

# Image Moderation API (Sightengine)
API_USER_MODERATOR=your_moderator_api_user
API_SECRET_MODERATOR=your_moderator_api_secret
